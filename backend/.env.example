NODE_ENV=production
PORT=8787

# GitHub OAuth App. The callback URL must point to this backend.
OWNER_GITHUB_LOGIN=wayflower
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://wayflower-content-api.onrender.com/auth/github/callback
FRONTEND_AUTH_RETURN_URL=https://wayflower.github.io/papers.html
FRONTEND_SHOWCASE_RETURN_URL=https://wayflower.github.io/showcase.html

# Generate at least 32 random characters for signing upload tokens.
TOKEN_SECRET=

# Fine-grained token scoped only to wayflower/wayflower.github.io with Contents: write.
GITHUB_TOKEN=
GITHUB_OWNER=wayflower
GITHUB_REPO=wayflower.github.io
GITHUB_BRANCH=main
GITHUB_API_VERSION=2026-03-10

ALLOWED_ORIGINS=https://wayflower.github.io,http://127.0.0.1:8000,http://localhost:8000
TRUST_PROXY=1
